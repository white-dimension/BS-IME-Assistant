<Window x:Class="BS.IME.Assistant.Views.FloatingStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS IME Status"
        Width="200"
        Height="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Border x:Name="Capsule"
            CornerRadius="24"
            Background="#CC1D4ED8"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Badge"
                    Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="#33FFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock x:Name="BadgeText"
                           Text="EN"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text="英文输入"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
