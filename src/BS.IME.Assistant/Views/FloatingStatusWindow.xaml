<Window x:Class="BS.IME.Assistant.Views.FloatingStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS IME Status"
        Width="180"
        Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Opacity="0.72"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Border x:Name="Capsule"
            CornerRadius="20"
            Background="#991D4ED8"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
        <Grid>
            <Grid x:Name="StatusPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="#33FFFFFF"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="Badge_MouseLeftButtonDown">
                    <TextBlock x:Name="BadgeText"
                               Text="EN"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="英文输入"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid x:Name="PromptPanel" Visibility="Collapsed" Margin="9,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PromptTitle"
                               Text="检测到 AutoCAD"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PromptSubtitle"
                               Text="启用 CAD 输入识别？"
                               Foreground="#DDE7F0"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="启用"
                        Width="44"
                        Height="24"
                        Margin="8,0,4,0"
                        Click="EnablePrompt_Click"/>
                <Button Grid.Column="2"
                        Content="暂不"
                        Width="44"
                        Height="24"
                        Click="DismissPrompt_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
