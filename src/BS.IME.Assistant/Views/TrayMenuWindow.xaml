<Window x:Class="BS.IME.Assistant.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS IME Menu"
        Width="270"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuBg" Color="#262626"/>
        <SolidColorBrush x:Key="MenuBorder" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSub" Color="#B9B9B9"/>
        <SolidColorBrush x:Key="HoverBg" Color="#363636"/>
        <SolidColorBrush x:Key="PressedBg" Color="#3E3E3E"/>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="14,4,14,4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource MenuBg}"
            BorderBrush="{StaticResource MenuBorder}"
            BorderThickness="1"
            CornerRadius="7"
            Padding="10,9"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.32"
                              Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource InfoTextStyle}"/>
            <TextBlock x:Name="ForegroundText" Style="{StaticResource InfoTextStyle}"/>
            <TextBlock x:Name="CurrentImeText" Style="{StaticResource InfoTextStyle}"/>
            <TextBlock x:Name="HotkeyFailureText"
                       Text="热键注册失败"
                       Foreground="#FCA5A5"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="13"
                       Margin="14,4,14,4"
                       Visibility="Collapsed"/>

            <Border Height="1" Background="#3A3A3A" Margin="2,8"/>

            <Button x:Name="ToggleButton" Style="{StaticResource MenuButtonStyle}" Click="ToggleButton_Click"/>
            <Button Content="显示悬浮窗" Style="{StaticResource MenuButtonStyle}" Click="ShowFloatingButton_Click"/>
            <Button Content="隐藏悬浮窗" Style="{StaticResource MenuButtonStyle}" Click="HideFloatingButton_Click"/>
            <Button Content="切换到中文" Style="{StaticResource MenuButtonStyle}" Click="SwitchChineseButton_Click"/>
            <Button Content="切换到英文" Style="{StaticResource MenuButtonStyle}" Click="SwitchEnglishButton_Click"/>

            <Border Height="1" Background="#3A3A3A" Margin="2,8"/>

            <Button Content="打开配置文件" Style="{StaticResource MenuButtonStyle}" Click="OpenSettingsButton_Click"/>
            <Button Content="打开日志目录" Style="{StaticResource MenuButtonStyle}" Click="OpenLogsButton_Click"/>

            <Border Height="1" Background="#3A3A3A" Margin="2,8"/>

            <Button Content="退出" Style="{StaticResource MenuButtonStyle}" Click="ExitButton_Click"/>
        </StackPanel>
    </Border>
</Window>
