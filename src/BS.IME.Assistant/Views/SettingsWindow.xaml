<Window x:Class="BS.IME.Assistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BS IME Assistant Settings"
        Width="860"
        Height="680"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Foreground="#F2F2F2"
        Background="#171717">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#171717"/>
        <SolidColorBrush x:Key="GroupBg" Color="#252525"/>
        <SolidColorBrush x:Key="GroupBorder" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextSub" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8E8E"/>
        <SolidColorBrush x:Key="Accent" Color="#4A9EFF"/>
        <SolidColorBrush x:Key="ControlBg" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="ControlBgHover" Color="#353535"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#474747"/>

        <x:Array x:Key="ImeOptions" Type="{x:Type ComboBoxItem}">
            <ComboBoxItem Content="英文" Tag="en"/>
            <ComboBoxItem Content="中文" Tag="zh"/>
        </x:Array>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SettingGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GroupBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GroupBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="66"/>
        </Style>
        <Style x:Key="RowSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    Width="50"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="#2D2D2D"
                                    BorderBrush="#8A8A8A"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Fill="#DCDCDC"
                                     HorizontalAlignment="Left"
                                     Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,5,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{StaticResource ControlBg}"
                                                BorderBrush="{StaticResource ControlBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,34,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#CFCFCF"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,13,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBgHover}"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#5A5A5A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource ControlBg}"
                                        BorderBrush="{StaticResource ControlBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource WindowBg}">
        <Border DockPanel.Dock="Bottom"
                Background="#202020"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="应用" Background="#275C9F" BorderBrush="#3E7CC9" Click="ApplyButton_Click"/>
                <Button Content="取消" Click="CancelButton_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26,30,22" MaxWidth="820" HorizontalAlignment="Center">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

                <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}"/>
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="启用 IME 助手" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="暂停后不会根据当前软件自动切换输入法。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="EnabledCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="启用 IME 助手"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="开机启动" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="登录 Windows 后自动启动 BS IME Assistant。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="开机启动"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="输入法" Style="{StaticResource SectionTitleStyle}"/>
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="中文输入法" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock x:Name="ChineseHklTextBlock" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="ChineseImeComboBox" Grid.Column="1" Width="300" Margin="16,0" VerticalAlignment="Center" DisplayMemberPath="FriendlyName" AutomationProperties.Name="中文输入法"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="英文输入法" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock x:Name="EnglishHklTextBlock" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="EnglishImeComboBox" Grid.Column="1" Width="300" Margin="16,0" VerticalAlignment="Center" DisplayMemberPath="FriendlyName" AutomationProperties.Name="英文输入法"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="AutoCAD" Style="{StaticResource SectionTitleStyle}"/>
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="启用 AutoCAD 增强" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="允许 CAD 插件把文字编辑状态发送给助手。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="CadIntegrationEnabledCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="启用 AutoCAD 增强"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="检测到 CAD 时提示" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="首次检测到 AutoCAD 时显示启用增强的提示。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="CadPromptOnDetectCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="检测到 CAD 时提示"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="软件规则" Style="{StaticResource SectionTitleStyle}"/>
                <ItemsControl x:Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingGroupStyle}">
                                <Grid MinHeight="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="16,10">
                                        <TextBox Text="{Binding Name, Mode=OneWay}"
                                                 Width="210"
                                                 Height="22"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextMain}"
                                                 FontWeight="SemiBold"
                                                 Padding="0"/>
                                        <TextBox Text="{Binding ProcessName, Mode=OneWay}"
                                                 Width="210"
                                                 Height="22"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextSub}"
                                                 Padding="0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{StaticResource ImeOptions}"
                                              SelectedValue="{Binding DefaultIme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              DisplayMemberPath="Content"
                                              Width="106"
                                              Margin="10,0"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="激活切换" Foreground="{StaticResource TextSub}" Margin="0,0,8,0"/>
                                        <CheckBox IsChecked="{Binding SwitchOnActivate, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 激活切换}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="启用" Foreground="{StaticResource TextSub}" Margin="0,0,8,0"/>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 启用}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="悬浮胶囊" Style="{StaticResource SectionTitleStyle}"/>
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="显示胶囊" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="和常规设置中的显示状态保持同步。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="CapsuleEnabledCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="显示悬浮胶囊"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="置顶显示" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="和常规设置中的胶囊置顶保持同步。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="CapsuleTopmostCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="胶囊置顶显示"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="胶囊尺寸" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="宽度和高度会在应用后立即生效。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="宽度" Foreground="{StaticResource TextSub}" Margin="0,0,6,0"/>
                                <TextBox x:Name="CapsuleWidthTextBox" Width="72" AutomationProperties.Name="胶囊宽度"/>
                                <TextBlock Text="高度" Foreground="{StaticResource TextSub}" Margin="12,0,6,0"/>
                                <TextBox x:Name="CapsuleHeightTextBox" Width="72" AutomationProperties.Name="胶囊高度"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="位置" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="修复胶囊跑出屏幕或快速回到右下角。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                <Button Content="重置到右下角" Click="ResetCapsuleButton_Click"/>
                                <Button Content="限制在屏幕内" Click="ClampCapsuleButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="高级" Style="{StaticResource SectionTitleStyle}"/>
                <Border Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="配置文件" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="高级用户可直接查看 settings.json。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开配置文件" Margin="16,0" VerticalAlignment="Center" Click="OpenConfigButton_Click"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}"/>
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="日志文件夹" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="用于排查输入法检测和切换问题。" Style="{StaticResource SettingDescriptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开日志文件夹" Margin="16,0" VerticalAlignment="Center" Click="OpenLogsButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
